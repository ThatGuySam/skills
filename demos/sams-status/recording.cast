[0.000, "o", "36muser\u001b[0m\r\nUse $sams-status to show the current project's relevant work and status.\r\n"]
[6.349, "o", "\u001b[35m\u001b[3mcodex\u001b[0m\u001b[0m\r\nI’m using the sams-status skill to check the project’s available sources and build a brief status tree.\r\n"]
