[0.000, "o", "/bin/zsh -lc \"ruby -e 'require \\\"yaml\\\"; p = ARGV[0]; s = File.read(p); m = s.match(/\\\\A---\\\\n(.*?)\\\\n---\\\\n/m) or abort \\\"missing frontmatter\\\"; y = YAML.safe_load(m[1]); abort \\\"bad fields\\\" unless y.keys.sort == %w[description name]; abort \\\"bad name\\\" unless y[\\\"name\\\"] == File.basename(File.dirname(p)) && y[\\\"name\\\"].match?(/\\\\A[a-z0-9]+(?:-[a-z0-9]+)*\\\\z/) && y[\\\"name\\\"].length < 64; abort \\\"bad description\\\" unless y[\\\"description\\\"].is_a?(String) && y[\\\"description\\\"].length.between?(1,1024); abort \\\"placeholder\\\" if s.include?(\\\"TODO\\\"); puts \\\"PASS: YAML, required fields, folder/name, description length, no TODO placeholders. No resource links to resolve.\\\"' /private/tmp/skills-demo-sams-skill-creator/home/.codex/skills/weekly-release-notes/SKILL.md > evidence/weekly-release-notes/structural-check.txt\"\u001b[0m in /private/tmp/skills-demo-sams-skill-creator/home/sams-skill-creator-demo\r\n"]
