[4.477, "o", "\u001b[35m\u001b[3mexec\u001b[0m\u001b[0m\r\n\u001b[1m/bin/zsh -lc \"pwd; rg --files -g '\"'!*.env*'\"' -g '\"'!node_modules'\"' -g '\"'!package-lock.json'\"' -g '\"'!pnpm-lock.yaml'\"' -g '\"'!yarn.lock'\"' -g '\"'!.git'\"' -g '\"'!*.pem'\"' -g '\"'!*.key'\"'; git status --short; git ls-files --stage -- '*AGENTS.md' '.env.example' '**/.env.example'\""]
