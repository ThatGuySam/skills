---
import '../styles/homepage.css';
const command = 'npx skills add ThatGuySam/skills';
---
<div class="skills-home">
  <a class="home-skip" href="#home-title">Skip to content</a>
  <nav class="home-nav" aria-label="Main navigation">
    <a class="home-brand" href="/" aria-label="Sam's Skills home"><svg width="23" height="25" viewBox="0 0 24 26" fill="none" aria-hidden="true"><path d="m12 1 10 6v12l-10 6L2 19V7L12 1Z M2 7l10 6 10-6 M12 1v24" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg><span>Sam's Skills</span></a>
    <div class="home-nav-links"><a href="#skills">Skills</a><a href="/collection/about/">About</a><a href="/collection/installation/">Docs</a></div>
    <a class="home-github" href="https://github.com/ThatGuySam/skills">GitHub <span aria-hidden="true">↗</span></a>
    <a class="home-button home-button-primary home-nav-cta" href="/collection/installation/">Get started</a>
  </nav>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-grid" aria-hidden="true"></div>
    <a class="home-pill home-reveal" href="/collection/about/"><span class="home-status-dot" aria-hidden="true"></span>Used by Sam. Packaged to share.<span aria-hidden="true">↗</span></a>
    <h1 id="home-title" tabindex="-1" class="home-reveal">Practical skills<br /><span>for your AI agents.</span></h1>
    <p class="home-description home-reveal">The workflows I use for sales research, UX audits, better prompts, and uncertain decisions. Ready for your agent to use, one skill at a time.</p>
    <div class="home-install home-reveal">
      <div class="home-command">
        <span class="home-prompt" aria-hidden="true">$</span>
        <code>{command}</code>
        <button
          type="button"
          id="home-copy"
          aria-label="Copy install command"
          aria-describedby="home-copy-status"
          data-command={command}
          data-state="idle"
        >
          <svg class="home-copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="8" y="8" width="12" height="12" rx="2" />
            <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
          </svg>
          <svg class="home-copy-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 12 4 4L19 6" />
          </svg>
        </button>
      </div>
      <span id="home-copy-status" class="home-copy-status" role="status" aria-live="polite"></span>
    </div>
    <div class="home-actions home-reveal"><a class="home-button home-button-primary" href="/collection/installation/">Get started <span aria-hidden="true">→</span></a><a class="home-button home-button-secondary" href="#skills">Browse the skills</a></div>
    <div class="home-compatibility home-reveal"><p>FOR AGENTS THAT SUPPORT SKILLS</p><div><span>Claude Code</span><span>Codex</span><span>Cursor</span><a href="/reference/compatibility/">See compatibility <span aria-hidden="true">↗</span></a></div></div>
  </section>
  <div class="home-details"><slot /></div>
  <footer class="home-footer"><a class="home-brand" href="/">Sam's Skills</a><p>Built from use. MIT licensed.</p><a href="https://github.com/ThatGuySam/skills">GitHub <span aria-hidden="true">↗</span></a></footer>
</div>
<script>
  const button = document.querySelector<HTMLButtonElement>('#home-copy');
  const status = document.querySelector<HTMLElement>('#home-copy-status');

  if (button && status) {
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    const messages = {
      idle: '',
      copied: 'Copied to clipboard',
      error: 'Could not copy. Select the command to copy it manually.',
    };
    const setState = (state: keyof typeof messages) => {
      button.dataset.state = state;
      status.textContent = messages[state];
    };

    button.addEventListener('pointerdown', () => {
      button.dataset.input = 'pointer';
    });
    button.addEventListener('keydown', () => {
      button.dataset.input = 'keyboard';
    });
    button.addEventListener('click', async (event) => {
      if (button.disabled || !button.dataset.command) return;
      button.dataset.input = event.detail === 0 ? 'keyboard' : 'pointer';
      clearTimeout(resetTimer);
      setState('idle');
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');

      try {
        await navigator.clipboard.writeText(button.dataset.command);
        setState('copied');
        resetTimer = setTimeout(() => setState('idle'), 2000);
      } catch {
        setState('error');
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
    });
  }
</script>
